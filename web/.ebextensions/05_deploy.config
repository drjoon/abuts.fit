option_settings:
  # Immutable avoids serving mixed old/new Vite hashed assets on the same
  # target group (RollingWithAdditionalBatch briefly runs two builds).
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Immutable
    BatchSizeType: Percentage
    BatchSize: "100"
  # Immutable temporarily doubles capacity; keep headroom above MinSize.
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "4"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz
    DeregistrationDelay: "60"
