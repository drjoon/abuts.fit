option_settings:
  # NOTE: Console/API option settings take precedence over .ebextensions.
  # eb.sh also applies these via `aws elasticbeanstalk update-environment`
  # so RollingWithAdditionalBatch cannot silently win again.
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Immutable
    BatchSizeType: Percentage
    BatchSize: "100"
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateType: Immutable
  # Immutable temporarily doubles capacity; keep headroom above MinSize.
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "4"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz
    DeregistrationDelay: "30"
    # Keep a browser on one instance during the brief dual-version window
    # so index.html and /assets/* hashes stay consistent.
    StickinessEnabled: "true"
    StickinessLBCookieDuration: "120"
