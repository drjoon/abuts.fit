# lot-server2. 복사해서 local.env 로 둔다.
PORT=8012
HOST=127.0.0.1

# 저장 폴더. lot-server 감시 폴더와 다르게 둔다.
LOT_CAPTURE_DIR=D:\bg\lot-server2\images

# 비우면 UM20 / ViTiny / USB Camera 이름을 고르고, 없으면 첫 영상 장치를 쓴다.
MICROSCOPE_DEVICE=
FFMPEG_PATH=

# 1이면 서버 기동 시 감시 시작. 기본 0(화면에서 시작). Continuity+자동감시는 부하가 큼.
LOT_AUTO_WATCH=0

# 감시 게이트 (실측 후 조정)
LOT_MOTION_THRESHOLD=6
LOT_SHARP_THRESHOLD=8
# 평균 밝기(0–255)가 이보다 낮으면 LED+AF 재시도
LOT_DARK_MEAN=28
# 흐림/어두움 시 AF 재시도 간격(ms)·움직임(아밍)당 최대 횟수
LOT_AF_COOLDOWN_MS=8000
LOT_AF_MAX_PER_ARM=3
LOT_STABLE_FRAMES=3
LOT_WATCH_POLL_MS=1200
LOT_HOLD_MS=2500
LOT_OCR_FRAMES=3
# 상주 ffmpeg가 라이브 JPEG를 덮어쓰는 속도
LOT_STREAM_FPS=2
