# lot-server. 복사해서 local.env 로 둔다.
PORT=8012
HOST=127.0.0.1

# 저장 폴더. lot-server 감시 폴더와 다르게 둔다.
LOT_CAPTURE_DIR=D:\bg\lot-server\images

# 비우면 UM20 / ViTiny / USB Camera 이름을 고르고, 없으면 첫 영상 장치를 쓴다.
MICROSCOPE_DEVICE=
FFMPEG_PATH=

# 1이면 서버 기동 시 감시 시작. 기본 0(화면에서 시작). Continuity+자동감시는 부하가 큼.
LOT_AUTO_WATCH=0

# 감시 게이트 (실측 후 조정)
LOT_MOTION_THRESHOLD=6
# 선명도: 타일 라플라시안 상위 10%(UM20 실측 흐림 약 1.5 / 초점 약 13.7)
LOT_SHARP_THRESHOLD=6
# 평균 밝기(0–255)가 이보다 낮으면 UVC 밝기 재제어·안내
LOT_DARK_MEAN=28
# 흐림 시 AF·어두움 시 UVC 재시도 간격(ms)·움직임(아밍)당 최대 횟수
LOT_AF_COOLDOWN_MS=8000
LOT_AF_MAX_PER_ARM=3
LOT_STABLE_FRAMES=3
LOT_WATCH_POLL_MS=1200
LOT_HOLD_MS=2500
LOT_OCR_FRAMES=3
# 상주 ffmpeg가 라이브 JPEG를 덮어쓰는 속도
LOT_STREAM_FPS=2
# OCR 최소 신뢰도(0–100)·아밍당 재시도
LOT_OCR_MIN_CONF=50
LOT_OCR_RETRY=2
# 오프라인 PC면 eng.traineddata 폴더 경로. 비우면 첫 인식 때 받아 ocr-cache/에 둔다.
LOT_OCR_LANG_PATH=
# 1이면 ViTiny mltcCom을 먼저 시도(이 UM20은 init-failed라 0)
LOT_VITINY_DLL=0
# 하드웨어 AF(UM 시리얼, CP210x COM). 0이면 끔. 포트를 고정하려면 LOT_UM_PORT=COM7
LOT_UM_SERIAL=1
LOT_UM_PORT=
# LED: 감시 시작 때 켜고 중지·종료 때 끔. 0이면 LED를 건드리지 않음
LOT_UM_LED=1
# 감시 시작 때 LED 단계(1-12). 비우면 리모컨으로 맞춘 단계 유지. 각인 금속은 1-2 권장(높으면 번쩍여 글자가 사라짐)
LOT_LED_LEVEL=

# 어벗츠 백엔드(큐·매칭·스크류 로트). /api 없이 루트만.
BACKEND_BASE=https://abuts.fit
# BACKEND_BASE=http://127.0.0.1:8080
# web/backend 의 LOT_SHARED_SECRET 과 동일해야 함
LOT_SHARED_SECRET=

# 같은 PC pack-server (공병·패킹 라벨)
PACK_SERVER_BASE=http://127.0.0.1:8004
PACK_PRINT_SERVER_SHARED_SECRET=
